# -----------------------------------------------------------------------------
# AICTE Complaint Monitoring & Status Dashboard - Environment Configuration
# -----------------------------------------------------------------------------

# PostgreSQL connection strings (Neon, Vercel Postgres, or local Docker)
# Pooled connection string used for serverless runtime queries
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aicte_db?pgbouncer=true"

# Direct connection string used for Prisma migrations
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aicte_db"

# Auth.js v5 Configuration
# AUTH_SECRET is REQUIRED in production. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET="replace_with_a_random_32_byte_secret"
#
# Do NOT set NEXTAUTH_URL / AUTH_URL to http://localhost:3000 for a deployed
# environment: Auth.js uses it for absolute redirects and logout would send
# users to localhost. Leave it unset so the request host is used (trustHost is
# enabled), or set it to the exact public origin, e.g.
#   AUTH_URL="https://your-vercel-domain.vercel.app"

# Vercel Blob Storage Token (required for file uploads in production)
# Automatically populated when attaching Vercel Blob in project settings
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_placeholder"

# Vercel Cron Secret (protects /api/cron/* route handlers)
CRON_SECRET="aicte_cron_authorization_bearer_token_2026"

# Feature Flags
NEXT_PUBLIC_ENABLE_PGVECTOR="false"
